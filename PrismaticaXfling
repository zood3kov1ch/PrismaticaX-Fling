_G.KUtil.MakeControlBtn = function(x, text, callback)
    _G.KUI["CtrlBtn_"..text]                         = Instance.new("TextButton", _G.KUI.Controls)
    _G.KUI["CtrlBtn_"..text].Size                    = UDim2.fromOffset(_G.KSettings.IS_MOBILE and 26 or 30, _G.KSettings.IS_MOBILE and 26 or 30)
    _G.KUI["CtrlBtn_"..text].Position                = UDim2.fromOffset(x, 0)
    _G.KUI["CtrlBtn_"..text].BackgroundColor3        = _G.KColors.Interactive
    _G.KUI["CtrlBtn_"..text].BackgroundTransparency  = 0.5
    _G.KUI["CtrlBtn_"..text].Text                    = text
    _G.KUI["CtrlBtn_"..text].Font                    = Enum.Font.FredokaOne
    _G.KUI["CtrlBtn_"..text].TextSize                = _G.KSettings.IS_MOBILE and 14 or 16
    _G.KUI["CtrlBtn_"..text].TextColor3              = _G.KColors.TextMain
    _G.KUI["CtrlBtn_"..text].AutoButtonColor         = false
    _G.KUI["CtrlBtn_"..text].ZIndex                  = 6
    _G.KUtil.AddCorner(_G.KUI["CtrlBtn_"..text], 8)

    local btn = _G.KUI["CtrlBtn_"..text]
    btn.MouseEnter:Connect(function()
        _G.KUtil.Tween(btn, 0.15, {BackgroundTransparency = 0.2, BackgroundColor3 = _G.KColors.InteractiveHover})
    end)
    btn.MouseLeave:Connect(function()
        _G.KUtil.Tween(btn, 0.15, {BackgroundTransparency = 0.5, BackgroundColor3 = _G.KColors.Interactive})
    end)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

