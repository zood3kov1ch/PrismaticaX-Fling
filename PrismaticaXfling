_G.KUtil.SkidFling = function(TargetPlayer)
    _G.SF_Character = _G.KServices.Players.LocalPlayer.Character
    _G.SF_Humanoid = _G.SF_Character and _G.SF_Character:FindFirstChildOfClass("Humanoid")
    _G.SF_RootPart = _G.SF_Humanoid and _G.SF_Humanoid.RootPart
    _G.SF_TCharacter = TargetPlayer.Character
    if not _G.SF_TCharacter then return end
    
    _G.SF_THumanoid = nil
    _G.SF_TRootPart = nil
    _G.SF_THead = nil
    _G.SF_Accessory = nil
    _G.SF_Handle = nil
    
    if _G.SF_TCharacter:FindFirstChildOfClass("Humanoid") then
        _G.SF_THumanoid = _G.SF_TCharacter:FindFirstChildOfClass("Humanoid")
    end
    if _G.SF_THumanoid and _G.SF_THumanoid.RootPart then
        _G.SF_TRootPart = _G.SF_THumanoid.RootPart
    end
    if _G.SF_TCharacter:FindFirstChild("Head") then
        _G.SF_THead = _G.SF_TCharacter.Head
    end
    if _G.SF_TCharacter:FindFirstChildOfClass("Accessory") then
        _G.SF_Accessory = _G.SF_TCharacter:FindFirstChildOfClass("Accessory")
    end
    if _G.SF_Accessory and _G.SF_Accessory:FindFirstChild("Handle") then
        _G.SF_Handle = _G.SF_Accessory.Handle
    end
    
        if _G.SF_Character and _G.SF_Humanoid and _G.SF_RootPart then
            if _G.SF_RootPart.Velocity.Magnitude < 50 and _G.SF_Humanoid.FloorMaterial ~= Enum.Material.Air then
                _G.OldPos = _G.SF_RootPart.CFrame
            end
            
            if _G.SF_THumanoid and _G.SF_THumanoid.Sit then
                if _G.ShowNotificationSafe then _G.ShowNotificationSafe("Error: " .. TargetPlayer.Name .. " is sitting") end
                return
            end
            
            if _G.SF_THead then
                workspace.CurrentCamera.CameraSubject = _G.SF_THead
            elseif _G.SF_Handle then
                workspace.CurrentCamera.CameraSubject = _G.SF_Handle
            elseif _G.SF_THumanoid and _G.SF_TRootPart then
                workspace.CurrentCamera.CameraSubject = _G.SF_THumanoid
            end
            
            if not _G.SF_TCharacter:FindFirstChildWhichIsA("BasePart") then
                return
            end
            
            _G.SF_FPos = function(BasePart, Pos, Ang)
                _G.SF_RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
                _G.SF_Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * Pos * Ang)
                _G.SF_RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                _G.SF_RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            end
            
            _G.SF_SFBasePart = function(BasePart)
                _G.SF_TimeToWait = 2
                _G.SF_Time = tick()
                _G.SF_Angle = 0
                repeat
                    if _G.SF_RootPart and _G.SF_THumanoid then
                        if BasePart.Velocity.Magnitude < 50 then
                            _G.SF_Angle = _G.SF_Angle + 100
                            _G.SF_FPos(BasePart, CFrame.new(0, 1.5, 0) + _G.SF_THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(_G.SF_Angle),0 ,0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, -1.5, 0) + _G.SF_THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(_G.SF_Angle), 0, 0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, 1.5, 0) + _G.SF_THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(_G.SF_Angle),0 ,0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, -1.5, 0) + _G.SF_THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(_G.SF_Angle), 0, 0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, 1.5, 0) + _G.SF_THumanoid.MoveDirection, CFrame.Angles(math.rad(_G.SF_Angle),0 ,0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, -1.5, 0) + _G.SF_THumanoid.MoveDirection, CFrame.Angles(math.rad(_G.SF_Angle), 0, 0))
                            task.wait()
                        else
                            _G.SF_FPos(BasePart, CFrame.new(0, 1.5, _G.SF_THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, -1.5, -_G.SF_THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, 1.5, _G.SF_THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()
                            
                            _G.SF_FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                            task.wait()
                            _G.SF_FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                            task.wait()
                        end
                    end
                until _G.SF_Time + _G.SF_TimeToWait < tick() or not _G.KData.FlingActive
            end
            
            workspace.FallenPartsDestroyHeight = 0/0
            
            -- Очищаем любые старые BodyVelocity, чтобы они не скапливались при спаме
            if _G.SF_RootPart then
                for _, v in pairs(_G.SF_RootPart:GetChildren()) do
                    if v.Name == "FlingBV" and v:IsA("BodyVelocity") then
                        v:Destroy()
                    end
                end
            end
            
            local sf_bv_local = Instance.new("BodyVelocity")
            sf_bv_local.Name = "FlingBV"
            sf_bv_local.Parent = _G.SF_RootPart
            sf_bv_local.Velocity = Vector3.new(0, 0, 0)
            sf_bv_local.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            
            _G.SF_Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            
            if _G.SF_TRootPart then
                _G.SF_SFBasePart(_G.SF_TRootPart)
            elseif _G.SF_THead then
                _G.SF_SFBasePart(_G.SF_THead)
            elseif _G.SF_Handle then
                _G.SF_SFBasePart(_G.SF_Handle)
            else
                if _G.ShowNotificationSafe then _G.ShowNotificationSafe("Error: " .. TargetPlayer.Name .. " has no valid parts") end
                return
            end
            
            if sf_bv_local then sf_bv_local:Destroy() end
            _G.SF_Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            workspace.CurrentCamera.CameraSubject = _G.SF_Humanoid
            
            if _G.OldPos then
                local restoreTime = tick()
                repeat
                    _G.SF_RootPart.CFrame = _G.OldPos * CFrame.new(0, .5, 0)
                    _G.SF_Character:SetPrimaryPartCFrame(_G.OldPos * CFrame.new(0, .5, 0))
                    _G.SF_Humanoid:ChangeState("GettingUp")
                    for _, part in pairs(_G.SF_Character:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.Velocity, part.RotVelocity = Vector3.new(), Vector3.new()
                        end
                    end
                    task.wait()
                until (_G.SF_RootPart.Position - _G.OldPos.p).Magnitude < 25 or tick() - restoreTime > 1
                workspace.FallenPartsDestroyHeight = _G.FPDH
            end
        else
            if _G.ShowNotificationSafe then _G.ShowNotificationSafe("Error: Your character is not ready") end
            return
        end
end

_G.KUtil.StartFling = function()
    if _G.KData.FlingActive then return end
    
    _G.SF_TargetCount = _G.KUtil.CountTable(_G.KData.SelectedTargets)
    if _G.SF_TargetCount == 0 then
        _G.KUI.StatusText.Text       = "No targets selected"
        _G.KUI.StatusText.TextColor3 = _G.KColors.Warning
        task.delay(1, function()
            _G.KUI.StatusText.Text       = "Select targets to fling"
            _G.KUI.StatusText.TextColor3 = _G.KColors.TextSub
        end)
        return
    end
    
    _G.KData.FlingActive = true
    if _G.AntiFling then _G.AntiFling.FlingActive = true end
    
    _G.KUtil.UpdateStatus()
    if _G.ShowNotificationSafe then _G.ShowNotificationSafe("Started flinging " .. _G.SF_TargetCount .. " targets") end
    
    task.spawn(function()
        while _G.KData.FlingActive do
            _G.SF_ValidTargets = {}
            for name, player in pairs(_G.KData.SelectedTargets) do
                if type(player) == "userdata" and player.Parent then
                    _G.SF_ValidTargets[name] = player
                else
                    _G.KData.SelectedTargets[name] = nil
                    if _G.KData.PlayerCheckboxes and _G.KData.PlayerCheckboxes[name] then
                        pcall(function()
                            _G.KData.PlayerCheckboxes[name].CheckMark.Visible = false
                            _G.KUtil.Tween(_G.KData.PlayerCheckboxes[name].CheckBox, 0.15, {BackgroundColor3 = _G.KColors.ToggleOff})
                            _G.KUtil.Tween(_G.KData.PlayerCheckboxes[name].Entry, 0.15, {BackgroundColor3 = _G.KColors.Card, BackgroundTransparency = 0.3})
                        end)
                    end
                end
            end
            
            for name, player in pairs(_G.SF_ValidTargets) do
                if _G.KData.FlingActive and _G.KData.SelectedTargets[name] then
                    _G.KUtil.SkidFling(player)
                    task.wait(0.1)
                elseif not _G.KData.FlingActive then
                    break
                end
            end
            
            _G.KUtil.UpdateStatus()
            task.wait(0.5)
        end
    end)
end

_G.KUtil.StopFling = function()
    if not _G.KData.FlingActive then return end
    _G.KData.FlingActive = false
    if _G.AntiFling then _G.AntiFling.FlingActive = false end
    
    if _G.KServices.Players.LocalPlayer.Character and _G.KServices.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        for _, v in pairs(_G.KServices.Players.LocalPlayer.Character.HumanoidRootPart:GetChildren()) do
            if v.Name == "FlingBV" and v:IsA("BodyVelocity") then
                v:Destroy()
            end
        end
    end
    
    _G.KUtil.UpdateStatus()
    if _G.ShowNotificationSafe then _G.ShowNotificationSafe("Fling has been stopped") end
end

