local _KResizing = false
local _KResizeStartSize, _KResizeStartMouse
local _K_MIN_W = _G.KSettings.IS_MOBILE and 240 or 340
local _K_MAX_W = _G.KSettings.IS_MOBILE and 480 or 700
local _K_MIN_H = _G.KSettings.IS_MOBILE and 320 or 400
local _K_MAX_H = _G.KSettings.IS_MOBILE and 640 or 820

_G.KUI.Resize.InputBegan:Connect(function(input)
    if _G.KSettings.MINIMIZED then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        _KResizing = true
        _KResizeStartSize = _G.KUI.Main.Size
        _KResizeStartMouse = input.Position
    end
end)

_G.KServices.UIS.InputChanged:Connect(function(input)
    if _G.KSettings.MINIMIZED then return end
    if _KResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - _KResizeStartMouse
        local newW = math.clamp(_KResizeStartSize.X.Offset + delta.X, _K_MIN_W, _K_MAX_W)
        local newH = math.clamp(_KResizeStartSize.Y.Offset + delta.Y, _K_MIN_H, _K_MAX_H)
        _G.KUI.Main.Size = UDim2.fromOffset(newW, newH)
        _G.KUI.Shadow.Size = UDim2.fromOffset(newW + 30, newH + 30)
        _G.KSettings.GUI_WIDTH = newW
        _G.KSettings.GUI_HEIGHT = newH

        -- Пересчёт позиций/размеров всех элементов при resize
        local btnAreaH = _G.KData.BtnAreaH
        local btnBotPad = _G.KData.BtnBotPad
        local midPad = _G.KData.MidPad
        local statusH = _G.KData.StatusHeight
        local topPad = _G.KData.TopPad

        -- Кнопки — всегда прибиты к низу
        _G.KUI.ButtonGridCard.Position = UDim2.new(0, 10, 1, -(btnAreaH + btnBotPad))

        -- Список игроков — занимает всё пространство между статусом и кнопками
        local cardTop = topPad + statusH + midPad
        local cardBot = btnAreaH + btnBotPad + midPad
        local cardH = newH - _G.KSettings.HEADER_HEIGHT - cardTop - cardBot
        _G.KUI.PlayerListCard.Size = UDim2.new(1, -20, 0, cardH)
        _G.KUI.PlayerListCard.Position = UDim2.fromOffset(10, cardTop)
    end
end)

_G.KServices.UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if _KResizing then
            _KResizing = false
            pcall(function()
                if writefile then
                    local saveData = {guiWidth = _G.KSettings.GUI_WIDTH, guiHeight = _G.KSettings.GUI_HEIGHT}
                    writefile("PrismaFlingSize.json", game:GetService("HttpService"):JSONEncode(saveData))
                end
            end)
        end
    end
end)

-- Загружаем сохранённый размер
pcall(function()
    if readfile and isfile and isfile("PrismaFlingSize.json") then
