_G.KUtil.Tween = function(obj, time, props, style, direction)
    style     = style     or Enum.EasingStyle.Quint
    direction = direction or Enum.EasingDirection.Out
    _G.KServices.TweenService:Create(obj, TweenInfo.new(time, style, direction), props):Play()
end

_G.KUtil.AddCorner = function(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or _G.KSettings.CORNER_RADIUS)
    c.Parent = parent
    return c
end

_G.KUtil.AddStroke = function(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color        = color        or _G.KColors.Border
    s.Thickness    = thickness    or 1.5
    s.Transparency = transparency or 0.7
    s.Parent = parent
    return s
end

_G.KUtil.CountTable = function(t)
    local n = 0
    for _ in pairs(t) do n = n + 1 end
    return n
end

_G.KUtil.GetGui = function()
    local ok, res = pcall(function()
        return gethui() or _G.KServices.CoreGui
    end)
    if ok and res then return res end
    return _G.KServices.Players.LocalPlayer:WaitForChild("PlayerGui")
end

