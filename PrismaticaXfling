-- ЛОГИКА: RefreshPlayerList
-- =============================================
_G.KUtil.RefreshPlayerList = function()
    for _, child in pairs(_G.KUI.PlayerScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    _G.KData.PlayerCheckboxes = {}

    local playerList = _G.KServices.Players:GetPlayers()
    table.sort(playerList, function(a, b) return a.Name:lower() < b.Name:lower() end)

    local searchText = (_G.KData.SearchFilter or ""):lower()

    for _, player in ipairs(playerList) do
        if player ~= _G.KServices.Players.LocalPlayer then
            if searchText == "" or player.Name:lower():find(searchText, 1, true) then

                local entry                      = Instance.new("Frame", _G.KUI.PlayerScroll)
                entry.Name                       = "Entry_" .. player.Name
                entry.Size                       = UDim2.new(1, 0, 0, _G.KSettings.IS_MOBILE and 40 or 46)
                entry.BackgroundColor3           = _G.KData.SelectedTargets[player.Name] and _G.KColors.Interactive or _G.KColors.Card
                entry.BackgroundTransparency     = _G.KData.SelectedTargets[player.Name] and 0.15 or 0.3
                entry.BorderSizePixel            = 0
                _G.KUtil.AddCorner(entry, 10)
                _G.KUtil.AddStroke(entry, _G.KColors.Border, 1, 0.75)

                -- Аватар слева
                local avatarImg                  = Instance.new("ImageLabel", entry)
                avatarImg.Name                   = "Avatar"
                avatarImg.Size                   = UDim2.fromOffset(_G.KSettings.IS_MOBILE and 30 or 34, _G.KSettings.IS_MOBILE and 30 or 34)
                avatarImg.Position               = UDim2.new(0, 8, 0.5, _G.KSettings.IS_MOBILE and -15 or -17)
                avatarImg.BackgroundColor3       = _G.KColors.Card
                avatarImg.BorderSizePixel        = 0
                avatarImg.Image                  = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. player.UserId .. "&width=48&height=48&format=png"
                avatarImg.ScaleType              = Enum.ScaleType.Crop
                
                _G["KAvatarCorner_" .. player.Name] = Instance.new("UICorner", avatarImg)
                _G["KAvatarCorner_" .. player.Name].CornerRadius = UDim.new(1, 0)

                _G["KAvatarStroke_" .. player.Name] = Instance.new("UIStroke", avatarImg)
                _G["KAvatarStroke_" .. player.Name].Color = _G.KColors.Border
                _G["KAvatarStroke_" .. player.Name].Transparency = 0.6
                _G["KAvatarStroke_" .. player.Name].Thickness = 1

                -- Имя игрока
                local nameLabel                  = Instance.new("TextLabel", entry)
                nameLabel.Name                   = "NameLabel"
                nameLabel.Size                   = UDim2.new(1, _G.KSettings.IS_MOBILE and -80 or -90, 1, 0)
                nameLabel.Position               = UDim2.fromOffset(_G.KSettings.IS_MOBILE and 46 or 50, 0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text                   = player.Name
                nameLabel.TextColor3             = _G.KColors.TextMain
                nameLabel.Font                   = Enum.Font.FredokaOne
                nameLabel.TextSize               = _G.KSettings.IS_MOBILE and 11 or 13
                nameLabel.TextXAlignment         = Enum.TextXAlignment.Left

                -- Чекбокс справа
                local cbSize = _G.KSettings.IS_MOBILE and 20 or 22
                local checkBox                   = Instance.new("Frame", entry)
                checkBox.Name                    = "CheckBox"
                checkBox.Size                    = UDim2.fromOffset(cbSize, cbSize)
                checkBox.Position                = UDim2.new(1, -(cbSize + 10), 0.5, -math.floor(cbSize / 2))
                checkBox.BackgroundColor3        = _G.KData.SelectedTargets[player.Name] and _G.KColors.ToggleOn or _G.KColors.ToggleOff
                checkBox.BorderSizePixel         = 0
                _G.KUtil.AddCorner(checkBox, 6)
                _G.KUtil.AddStroke(checkBox, _G.KColors.Border, 1.2, 0.4)

                local checkMark                  = Instance.new("TextLabel", checkBox)
                checkMark.Name                   = "CheckMark"
                checkMark.Size                   = UDim2.fromScale(1, 1)
                checkMark.BackgroundTransparency = 1
                checkMark.Text                   = "✓"
                checkMark.TextColor3             = Color3.new(1, 1, 1)
                checkMark.Font                   = Enum.Font.GothamBold
                checkMark.TextSize               = _G.KSettings.IS_MOBILE and 16 or 18
                checkMark.TextScaled             = false
                checkMark.Visible                = (_G.KData.SelectedTargets[player.Name] ~= nil)

                -- Кликабельная область
                local clickArea                  = Instance.new("TextButton", entry)
                clickArea.Size                   = UDim2.fromScale(1, 1)
                clickArea.BackgroundTransparency = 1
                clickArea.Text                   = ""
                clickArea.ZIndex                 = 10
                clickArea.AutoButtonColor        = false

                clickArea.MouseButton1Click:Connect(function()
                    if _G.KData.SelectedTargets[player.Name] then
                        _G.KData.SelectedTargets[player.Name] = nil
                        checkMark.Visible = false
                        _G.KUtil.Tween(checkBox, 0.15, {BackgroundColor3 = _G.KColors.ToggleOff})
                        _G.KUtil.Tween(entry, 0.15, {BackgroundColor3 = _G.KColors.Card, BackgroundTransparency = 0.3})
                    else
                        _G.KData.SelectedTargets[player.Name] = player
                        checkMark.Visible = true
                        _G.KUtil.Tween(checkBox, 0.15, {BackgroundColor3 = _G.KColors.ToggleOn})
                        _G.KUtil.Tween(entry, 0.15, {BackgroundColor3 = _G.KColors.Interactive, BackgroundTransparency = 0.15})
                    end
                    _G.KUtil.UpdateStatus()
                end)

                clickArea.MouseEnter:Connect(function()
                    if not _G.KData.SelectedTargets[player.Name] then
                        _G.KServices.TweenService:Create(entry, TweenInfo.new(0.12), {BackgroundColor3 = _G.KColors.InteractiveHover, BackgroundTransparency = 0.1}):Play()
                    end
                end)
                clickArea.MouseLeave:Connect(function()
                    if not _G.KData.SelectedTargets[player.Name] then
                        _G.KServices.TweenService:Create(entry, TweenInfo.new(0.12), {BackgroundColor3 = _G.KColors.Card, BackgroundTransparency = 0.3}):Play()
                    end
                end)

                _G.KData.PlayerCheckboxes[player.Name] = {Entry = entry, CheckBox = checkBox, CheckMark = checkMark}
            end
        end
    end
    _G.KUtil.UpdateStatus()
end

-- =============================================
-- ЛОГИКА: ToggleAllPlayers
-- =============================================
_G.KUtil.ToggleAllPlayers = function(select)
    for _, player in ipairs(_G.KServices.Players:GetPlayers()) do
        if player ~= _G.KServices.Players.LocalPlayer then
            if select then
                _G.KData.SelectedTargets[player.Name] = player
            else
                _G.KData.SelectedTargets[player.Name] = nil
            end
            local cb = _G.KData.PlayerCheckboxes[player.Name]
            if cb then
                -- Убираем твины, чтобы не было лагов/зависаний при спаме на 40+ игроков
                if select then
                    cb.CheckMark.Visible = true
                    cb.CheckBox.BackgroundColor3 = _G.KColors.ToggleOn
                    cb.Entry.BackgroundColor3 = _G.KColors.Interactive
                    cb.Entry.BackgroundTransparency = 0.15
                else
                    cb.CheckMark.Visible = false
                    cb.CheckBox.BackgroundColor3 = _G.KColors.ToggleOff
                    cb.Entry.BackgroundColor3 = _G.KColors.Card
                    cb.Entry.BackgroundTransparency = 0.3
                end
            end
        end
    end
    _G.KUtil.UpdateStatus()
end

