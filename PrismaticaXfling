        if saved and saved.guiWidth then
            _G.KSettings.GUI_WIDTH = math.clamp(saved.guiWidth, _K_MIN_W, _K_MAX_W)
        end
        if saved and saved.guiHeight then
            _G.KSettings.GUI_HEIGHT = math.clamp(saved.guiHeight, _K_MIN_H, _K_MAX_H)
        end
    end
end)

